{
  "name": "serverforge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter @serverforge/api prisma db push",
    "db:migrate": "pnpm --filter @serverforge/api prisma migrate dev",
    "db:seed": "pnpm --filter @serverforge/api prisma db seed"
  }
}
